{
  "name": "@bb/server-contract",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api/thread-client-constants": {
      "source": "./src/api/thread-client-constants.ts",
      "types": "./src/api/thread-client-constants.ts",
      "default": "./src/api/thread-client-constants.ts"
    },
    "./api/device-handoff": {
      "source": "./src/api/device-handoff.ts",
      "types": "./src/api/device-handoff.ts",
      "default": "./src/api/device-handoff.ts"
    },
    "./api/shared": {
      "source": "./src/api/shared.ts",
      "types": "./src/api/shared.ts",
      "default": "./src/api/shared.ts"
    },
    "./api/thread-signals": {
      "source": "./src/api/thread-signals.ts",
      "types": "./src/api/thread-signals.ts",
      "default": "./src/api/thread-signals.ts"
    },
    "./device-handoff-identity": {
      "source": "./src/device-handoff-identity.ts",
      "types": "./src/device-handoff-identity.ts",
      "default": "./src/device-handoff-identity.ts"
    },
    "./api/thread-tabs": {
      "source": "./src/api/thread-tabs.ts",
      "types": "./src/api/thread-tabs.ts",
      "default": "./src/api/thread-tabs.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@bb/domain": "workspace:*",
    "@bb/hono-typed-routes": "workspace:*",
    "@bb/host-daemon-contract": "workspace:*",
    "@bb/provider-bridge-protocol": "workspace:*",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bb/test-helpers": "workspace:*",
    "@bb/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
