{
  "name": "@bb/cli",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "bb": "./bin/bb",
    "title": "./bin/title"
  },
  "scripts": {
    "build": "node ../../scripts/build-node-entry.mjs src/index.ts dist/index.js --clean-dist --split",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bb/client-core": "workspace:*",
    "@bb/config": "workspace:*",
    "@bb/core-ui": "workspace:*",
    "@bb/domain": "workspace:*",
    "@bb/host-daemon-contract": "workspace:*",
    "@bb/plugin-build": "workspace:*",
    "@bb/process-utils": "workspace:*",
    "@bb/sdk": "workspace:*",
    "@bb/server-archive": "workspace:*",
    "@bb/server-contract": "workspace:*",
    "@bb/templates": "workspace:*",
    "@bb/text-utils": "workspace:*",
    "@bb/thread-view": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "bb-plugin-bb--git": "workspace:*",
    "bb-plugin-bb--github-pr-status": "workspace:*",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "mime-types": "^3.0.2",
    "@bb/process-utils": "workspace:*",
    "node-pty": "1.2.0-beta.15",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "bb-plugin-provider-codex": "workspace:*",
    "@bb/test-helpers": "workspace:*",
    "@bb/tsconfig": "workspace:*",
    "@tailwindcss/node": "4.3.0",
    "@tailwindcss/oxide": "4.3.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "exports": {
    "./native-session-files": {
      "source": "./src/native-session-files.ts",
      "types": "./src/native-session-files.ts",
      "default": "./src/native-session-files.ts"
    }
  }
}
