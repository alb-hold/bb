{
  "extends": [
    "@bb/tsconfig/base.json",
    "@bb/tsconfig/typecheck-overrides.json"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/components/ui/context-menu": [
        "../../packages/shared-ui/src/components/ui/context-menu.tsx"
      ],
      "@/components/ui/dropdown-menu": [
        "../../packages/shared-ui/src/components/ui/dropdown-menu.tsx"
      ],
      "@/components/ui/icon": [
        "../../packages/plugin-registry/flavors/components/ui/icon.tsx"
      ],
      "@/lib/utils": ["../../packages/shared-ui/src/lib/utils.ts"],
      "@/*": ["./src/*"]
    },
    "rootDir": "../..",
    // Pin auto-included global type packages (like the sibling apps do):
    // without this, tsc walks up past the repo and pulls in whatever
    // @types happen to sit in ancestor node_modules (e.g. @types/bun in
    // $HOME breaks `typeof fetch` assignability program-wide).
    "types": ["node", "react", "react-dom"]
  },
  "include": ["src", "test", "tests", "fixtures", "stories"]
}
